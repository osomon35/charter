# ---------------------------------------------------------------------------
# Charter — environment variables
#
# Copy to .env.local for local work, and paste the same values into
# Vercel → Project Settings → Environment Variables for deployment.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Same page, "service_role" secret. SERVER ONLY — this key bypasses RLS
# completely. It must never appear in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Owner allowlist ------------------------------------------------------
# Comma-separated. Only these addresses can hold an account at all.
# The database owner_allowlist table is the real authority (see
# supabase/migrations); this is the app-layer mirror used at the login gate.
OWNER_ALLOWLIST=joao@cobalto.cc

# --- App ------------------------------------------------------------------
# Canonical origin, no trailing slash. Used to build magic-link and signer
# URLs, so it must match the deployment it is serving.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) — REQUIRED from Phase 5 onwards -----------------------
# Without these, envelopes are still created and links still work, but no
# emails go out and the send reports which addresses could not be reached.
RESEND_API_KEY=
EMAIL_FROM=Charter <contracts@your-verified-domain>

# --- Secrets — REQUIRED from Phase 5 onwards ------------------------------
# Signer tokens are HMAC-SHA256'd with this pepper before storage, so a
# database leak alone does not let anyone brute-force a token.
#   generate with:  openssl rand -base64 32
SIGNER_TOKEN_PEPPER=

# Authenticates the Vercel Cron endpoints (auto-reminders, trash purge).
#   generate with:  openssl rand -base64 32
CRON_SECRET=

# --- Development escape hatch ---------------------------------------------
# When "true", signing links are shown in the UI after a send instead of only
# being emailed. Useful before a Resend domain has finished verifying.
#
# Each revealed URL is a live credential: whoever opens it can sign as that
# recipient. Never set this in production, and unset it once email works.
REVEAL_SIGNING_LINKS=
